# NyayaIQ backend deployment configuration
# The Vercel frontend origin must be listed in CORS_ORIGINS in production.
CORS_ORIGINS=https://crime-gpt-tau.vercel.app

# Gemini API Configuration
# Get your API key from Google AI Studio (starts with AIzaSy)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication Config
SECRET_KEY=generate_a_long_random_hex_string_here

# SQLite Database Location
DATABASE_URL=sqlite:///./db/crimegpt.db

# Email Notification & Approval Settings
ADMIN_NOTIFICATION_EMAIL=rituchaudhary15077@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password
APP_BASE_URL=http://localhost:8000
