# API Base URL for the NyayaIQ frontend.
# In local development: http://127.0.0.1:8000/api
# In Vercel: set this exact variable in Project Settings → Environment Variables
# to the separately deployed FastAPI backend origin (for example,
# https://your-backend-domain.onrender.com/api). It is embedded at build time,
# so redeploy Vercel after changing it. Do not point it at the Vercel frontend.
VITE_API_URL=http://127.0.0.1:8000/api
